# Connection Strings (Mapeado a la configuracion["ConnectionStrings:DefaultConnection"])
ConnectionStrings__DefaultConnection="RELLENAR CON CADENA PROPIA"

# Datos de JWT, para generar una clave segura, correr el siguiente comando en la terminal de visual studio, requiere node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
Jwt__Key=RELLENAR CON CLAVE RANDOM PROPIA
